#ifndef CONFIG_H
#define CONFIG_H

// ==========================================
// WiFi Credentials
// ==========================================
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// ==========================================
// HiveMQ Cloud Credentials (TLS Port 8883)
// ==========================================
#define MQTT_BROKER   "your-cluster-id.s1.eu.hivemq.cloud"
#define MQTT_PORT     8883
#define MQTT_USERNAME "your_username"
#define MQTT_PASSWORD "your_password"

// ==========================================
// MQTT Topic
// ==========================================
#define MQTT_TOPIC_COMMANDS "car/commands"

// ==========================================
// L298N Motor Driver Pin Assignments
// ==========================================
// Left Motor
#define PIN_ENA 14  // PWM Speed Control (LEDC)
#define PIN_IN1 27  // Direction 1
#define PIN_IN2 26  // Direction 2

// Right Motor
#define PIN_ENB 12  // PWM Speed Control (LEDC)
#define PIN_IN3 25  // Direction 1
#define PIN_IN4 33  // Direction 2

// ==========================================
// Motor PWM Configuration (ESP32 LEDC)
// ==========================================
#define PWM_FREQ         5000  // 5 kHz
#define PWM_RESOLUTION   8     // 8-bit (0-255)
#define PWM_DEFAULT_SPEED 200   // Default driving duty cycle (0-255)
#define LEDC_CHANNEL_LEFT  0
#define LEDC_CHANNEL_RIGHT 1

#endif // CONFIG_H
